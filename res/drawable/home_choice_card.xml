<!-- andr36oid: a home screen option on the "Choose your home screen" page. The chosen one
     gets a thick accent border; the focus ring (focus_ring, drawn as the foreground) shows
     where the d-pad is. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="3dp"
                android:color="?android:attr/colorAccent" />
            <corners android:radius="@dimen/focus_ring_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/home_choice_card_border" />
            <corners android:radius="@dimen/focus_ring_radius" />
        </shape>
    </item>
</selector>
