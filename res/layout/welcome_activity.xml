<!-- Uses the non-scrolling blank template: in the default template the
     content sits in a ScrollView, so the full-width logo grew taller than a
     640x480 landscape screen and pushed the start button off screen. Here the
     logo only gets the height left over by the buttons. -->
<com.google.android.setupdesign.GlifLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_wizard_layout"
    android:layout="@layout/sud_glif_blank_template"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- andr36oid: our logo as on the boot screen, LineageOS credited small in the
         lower left corner, where the centred buttons leave room -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/SudContentFrame">

            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:src="@drawable/andr36oid_logo"
                android:scaleType="fitCenter"
                android:padding="@dimen/content_margin_left" />

            <Button
                android:id="@+id/start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/start"
                android:focusedByDefault="true"
                android:foreground="@drawable/focus_ring"
                style="@style/SudGlifButton.Primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/emerg_dialer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/ic_dialer"
                    android:drawableTint="?attr/colorAccent"
                    android:text="@string/emergency_call"
                    android:foreground="@drawable/focus_ring"
                    style="@style/SudGlifButton.Secondary" />

                <Button
                    android:id="@+id/launch_accessibility"
                    android:nextFocusRight="@id/credits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/ic_eye"
                    android:drawableTint="?attr/colorAccent"
                    android:text="@string/accessibility_settings"
                    android:foreground="@drawable/focus_ring"
                    style="@style/SudGlifButton.Secondary" />

            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/based_on"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/andr36oid_based_on_height"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/content_margin_left"
            android:layout_marginBottom="@dimen/andr36oid_based_on_margin_bottom"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/based_on_lineageos"
            android:contentDescription="@string/andr36oid_based_on_lineageos" />
        <!-- andr36oid: opens the credits; small secondary button in the lowest right
             corner, clear of the centred emergency/accessibility row; hidden when the
             app is missing -->
        <Button
            android:id="@+id/credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/content_margin_left"
            android:layout_marginBottom="@dimen/andr36oid_based_on_margin_bottom"
            android:nextFocusUp="@id/start"
            android:text="@string/andr36oid_credits"
            android:foreground="@drawable/focus_ring"
            style="@style/SudGlifButton.Secondary" />
    </FrameLayout>
</com.google.android.setupdesign.GlifLayout>
