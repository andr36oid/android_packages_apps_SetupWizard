<org.lineageos.setupwizard.widget.ScrimInsetsFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    app:insetForeground="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        style="@style/SudContentFrame">

        <ImageView
            android:id="@+id/brand_logo"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1"
            android:src="@drawable/andr36oid_logo"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:gravity="center"
            android:padding="@dimen/content_margin_left"/>

        <!-- andr36oid: the software is free; a seller who charged for it scammed the buyer -->
        <LinearLayout
            android:id="@+id/free_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/content_margin_left"
            android:layout_marginEnd="@dimen/content_margin_left"
            android:layout_marginBottom="8dp"
            android:background="@drawable/andr36oid_free_box"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/andr36oid_free_title"
                android:textColor="?android:attr/colorAccent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.1"
                android:text="@string/andr36oid_free_body"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <org.lineageos.setupwizard.NavigationLayout
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- andr36oid: LineageOS credited small in the lower left corner, left of Next -->
    <ImageView
        android:id="@+id/based_on"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/andr36oid_based_on_height"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/content_margin_left"
        android:layout_marginBottom="@dimen/andr36oid_based_on_margin_bottom"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:src="@drawable/based_on_lineageos"
        android:contentDescription="@string/andr36oid_based_on_lineageos" />

    <ImageView
        android:id="@+id/reveal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/reveal"
        android:visibility="invisible"/>

</org.lineageos.setupwizard.widget.ScrimInsetsFrameLayout>
